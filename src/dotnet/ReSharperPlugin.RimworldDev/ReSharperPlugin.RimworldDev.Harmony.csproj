<Project>

    <PropertyGroup>
        <LanguageTargets>$(MSBuildToolsPath)\Microsoft.CSharp.targets</LanguageTargets>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    
    <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

    <ItemGroup>
        <Compile Remove="**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Lib.Harmony"
                          Version="2.*"
                          GeneratePathProperty="true" />
    </ItemGroup>

    <Target Name="CopyHarmony" AfterTargets="Build">

        <ItemGroup>
            <!-- Only the net472 build loads under the game's Mono; lib\** would copy every TFM onto the same file
                 and ship whichever came last (e.g. netcoreapp3.1, which can't resolve System.Runtime in-game) -->
            <HarmonyDll Include="$(PkgLib_Harmony)\lib\net472\0Harmony.dll" />
        </ItemGroup>

        <Copy
            SourceFiles="@(HarmonyDll)"
            DestinationFolder="../../rider/main/resources/UnityDoorstop/Linux/Doorstop" />

        <Copy
            SourceFiles="@(HarmonyDll)"
            DestinationFolder="../../rider/main/resources/UnityDoorstop/macOS/Doorstop" />

        <Copy
            SourceFiles="@(HarmonyDll)"
            DestinationFolder="../../rider/main/resources/UnityDoorstop/Windows/Doorstop" />
    </Target>
</Project>